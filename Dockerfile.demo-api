FROM eclipse-temurin:21-jdk-jammy AS build

WORKDIR /workspace
COPY . .
RUN ./mvnw -q -pl ledgerguard-demo-api -am -DskipTests package

FROM eclipse-temurin:21-jre-jammy

WORKDIR /app
COPY --from=build /workspace/ledgerguard-demo-api/target/ledgerguard-demo-api-0.1.0-SNAPSHOT.jar app.jar

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC"
EXPOSE 8080

USER 1001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
